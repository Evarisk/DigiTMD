#
# Generic
#

ModuleDoliTMDName      = DoliTMD
ModuleDoliTMDDesc      = TMD requests: a mail received on the TMD mailbox creates a ticket, followed until it is invoiced
DoliTMDDescription     = TMD requests: a mail received on the TMD mailbox creates a ticket, followed until it is invoiced
DoliTMDDescriptionLong = Each mail received on the TMD mailbox (module Inbox) creates a ticket assigned to the chosen person, linked to the thirdparty or the contact of the sender, and a TMD request followed until it is invoiced.
DoliTMD                = DoliTMD

